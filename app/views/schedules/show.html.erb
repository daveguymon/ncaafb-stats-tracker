<% content_for :title, "Utah Football | Season Schedule" %>

<main class="dashboard">
  <%= render "shared/masthead" %>

  <section class="hero">
    <div>
      <p class="eyebrow"><span class="live-dot"></span> THE SEASON, IN FOCUS</p>
      <h1>Every game.<br><em>One season.</em></h1>
      <p class="hero-description">Explore the Utah Utes schedule, from kickoff to the final whistle.</p>
    </div>
    <div class="hero-watermark" aria-hidden="true">UTAH</div>
  </section>

  <section class="workspace" aria-label="Schedule explorer">
    <aside class="sidebar">
      <div class="section-heading"><span>01</span> UTAH SCHEDULE</div>
      <form action="<%= root_path %>" method="get">
        <div class="field-label">TEAM</div>
        <div class="team-info"><%= image_tag "utah-logo.png", class: "team-badge", alt: "", width: 42, height: 42 %><span>Utah Utes<small>This tracker covers Utah football</small></span></div>
        <label for="season">SEASON YEAR</label>
        <input id="season" name="season" type="number" inputmode="numeric" min="1000" max="9999" step="1" value="<%= @season %>" required>
        <p class="field-help"><%= demo_mode? ? "Demo data is available for 2024 only." : "Enter a past or current season year." %></p>
        <button type="submit">View schedule <span aria-hidden="true">&rarr;</span></button>
      </form>

      <div class="flow">
        <div class="section-heading"><span>02</span> REQUEST FLOW</div>
        <p>How your schedule gets here</p>
        <ol>
          <li><strong>Season year</strong><small>Utah Utes &middot; <%= @season %></small></li>
          <% if demo_mode? %>
            <li><strong>Bundled sample</strong><small>Loads synthetic schedule data</small></li>
          <% else %>
            <li><strong>App cache</strong><small>Checks for a saved response</small></li>
            <li><strong>Sportradar API</strong><small>Requests schedules if needed</small></li>
          <% end %>
          <li><strong>Game list</strong><small>Filters and orders Utah games</small></li>
        </ol>
        <p class="flow-note"><%= demo_mode? ? "This fictional sample contains one regular-season game and no postseason games." : "Regular season and postseason schedules are requested. A missing postseason is skipped." %></p>
      </div>
    </aside>

    <section class="results" aria-labelledby="schedule-heading">
      <div class="results-header">
        <div>
          <p class="eyebrow">UTAH UTES <span class="separator">/</span> <%= @season %> SEASON</p>
          <h2 id="schedule-heading">Game schedule<span>.</span></h2>
          <p class="results-subtitle">Regular season &amp; postseason <span>&middot;</span> Times shown in UTC</p>
          <p class="results-subtitle">Records entering each game use available completed results. Coverage is unverified when missing games cannot be ruled out; future games show results so far.</p>
        </div>
        <% if @games %><div class="game-count"><strong><%= format("%02d", @games.size) %></strong><span>GAMES</span></div><% end %>
      </div>

      <%= render "shared/freshness", entries: @freshness if @freshness.present? %>
      <% if @error %>
        <div class="state-message error" role="alert"><strong>Schedule unavailable</strong><p><%= @error %></p></div>
      <% elsif @games.empty? %>
        <div class="state-message"><strong>No games found</strong><p>No Utah games were returned for this season. Try another year.</p></div>
      <% else %>
        <div class="list-label" aria-hidden="true"><span>DATE / WEEK</span><span>MATCHUP</span><span>LOCATION</span><span>RESULT / STATUS</span></div>
        <ol class="game-list">
          <% @games.each do |game| %>
            <%= render "game", game: game, records: @records.fetch(game.object_id), season: @season %>
          <% end %>
        </ol>
      <% end %>
      <div class="data-source"><span class="live-dot"></span> <%= demo_mode? ? "SYNTHETIC DEMO DATA / NOT AN ACTUAL GAME" : "DATA PROVIDED BY SPORTRADAR / SUBJECT TO AVAILABILITY" %></div>
    </section>
  </section>
  <footer><span>UTAH FOOTBALL STATS TRACKER</span><span>BUILT FOR THE GAME.</span></footer>
</main>
