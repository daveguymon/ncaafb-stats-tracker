<% content_for :title, "Utah Football | Play-by-Play" %>
<% content_for :head do %>
  <%= javascript_include_tag "replay", defer: true %>
<% end %>

<main class="dashboard">
  <%= render "shared/masthead" %>
  <div class="game-page">
    <%= link_to "← Back to schedule", @season ? root_path(season: @season) : root_path, class: "back-link" %>

    <% if @error %>
      <div class="state-message error" role="alert"><strong>Play-by-play unavailable</strong><p><%= @error %></p></div>
    <% else %>
      <% summary = @game["summary"] || {}; away = summary["away"] || {}; home = summary["home"] || {} %>
      <%= render "scoreboard", game: @game, summary: summary, away: away, home: home %>

      <%= render "shared/freshness", entries: @freshness if @freshness.present? %>
      <section class="progression" aria-labelledby="progression-heading">
        <div class="progression-heading">
          <div><p class="eyebrow">THE GAME, PLAY BY PLAY</p><h1 id="progression-heading">Game progression<span>.</span></h1>
            <p class="results-subtitle"><%= demo_mode? ? "A small selection of fictional events demonstrates the game view; this is not a complete play-by-play." : "Events are shown in the order provided by Sportradar. Inferred drive results are derived from play data. Refresh uses the app's cache." %></p></div>
          <%= link_to "Reload game ↻", game_path(params[:id], season: @season), class: "refresh-link" %>
        </div>
        <% if @periods.none? { |period| period["pbp"].present? } %>
          <div class="state-message"><strong>No play-by-play available yet</strong><p><%= demo_mode? ? "No events are included in this demo game." : "Events will appear here when Sportradar provides them. Refresh to check again." %></p></div>
        <% else %>
          <%= render "replay" %>
          <nav class="period-nav" aria-label="Jump to period">
            <% @periods.each_with_index do |period, index| %>
              <a href="#period-<%= index + 1 %>"><%= period_name(period, index) %></a>
            <% end %>
          </nav>
          <% @periods.each_with_index do |period, index| %>
            <section class="period" id="period-<%= index + 1 %>" aria-labelledby="period-heading-<%= index + 1 %>">
              <h2 id="period-heading-<%= index + 1 %>"><%= period_name(period, index) %></h2>
              <% if period["pbp"].blank? %>
                <p class="period-empty">No events available for this period.</p>
              <% else %>
                <% period["pbp"].each_with_index do |entry, entry_index| %>
                  <% if entry["type"] == "drive" %>
                    <div class="drive">
                      <div class="drive-heading"><strong><%= drive_team_name(entry, summary) %> drive</strong>
                        <span><%= [entry["play_count"] && "#{entry["play_count"]} plays", entry["net_yards"] && "#{entry["net_yards"]} yards", drive_result(entry, period["pbp"].drop(entry_index + 1), @periods[index + 1])].compact.join(" · ") %></span>
                      </div>
                      <% if entry["events"].blank? %><p class="period-empty">No events available for this drive.</p><% end %>
                      <ol class="event-list"><%= render partial: "event", collection: entry["events"] || [], as: :event, locals: { period_label: period_name(period, index) } %></ol>
                    </div>
                  <% else %>
                    <ol class="event-list standalone-event"><%= render "event", event: entry, period_label: period_name(period, index) %></ol>
                  <% end %>
                <% end %>
              <% end %>
            </section>
          <% end %>
        <% end %>
      </section>
      <div class="data-source"><span class="live-dot"></span> <%= demo_mode? ? "SYNTHETIC DEMO DATA / NOT AN ACTUAL GAME" : "DATA PROVIDED BY SPORTRADAR / SUBJECT TO AVAILABILITY" %></div>
    <% end %>
  </div>
  <footer><span>UTAH FOOTBALL STATS TRACKER</span><span>BUILT FOR THE GAME.</span></footer>
</main>
