<li class="game-event" data-replay-period="<%= period_label %>"
    data-replay-away-score="<%= event["away_points"] if event["away_points"].is_a?(Integer) && event["away_points"] >= 0 %>"
    data-replay-home-score="<%= event["home_points"] if event["home_points"].is_a?(Integer) && event["home_points"] >= 0 %>">
  <div class="event-clock"><%= event["clock"].presence || "—" %></div>
  <div class="event-content">
    <div class="event-meta">
      <span><%= (event["play_type"].presence || event["event_type"].presence || event["type"].presence || "event").tr("_-", " ").upcase %></span>
      <% if game_event_context(event).present? %><span><%= game_event_context(event) %></span><% end %>
      <% if !event["away_points"].nil? && !event["home_points"].nil? %><span>AWAY <%= event["away_points"] %> – <%= event["home_points"] %> HOME</span><% end %>
    </div>
    <p><%= event["description"].presence || "Description not available." %></p>
    <details class="response-details event-details">
      <summary>Event details &amp; statistics <span aria-hidden="true">+</span></summary>
      <pre><%= JSON.pretty_generate(event) %></pre>
    </details>
  </div>
</li>
